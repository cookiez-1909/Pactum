pragma solidity 0.8.30;

import {stdJson} from "forge-std/StdJson.sol";
import {Test} from "forge-std/Test.sol";
import {ReturnDesk} from "../src/ReturnDesk.sol";

/// @notice Checks the real contract's hashes against vectors generated by viem. The Rust tests read the same file.
contract HashVectorsTest is Test {
    using stdJson for string;

    function test_digestMatchesSharedVectors() public {
        string memory json = vm.readFile("test/vectors/case_terms.json");
        uint256 count = json.readUint(".count");
        assertGe(count, 4);

        for (uint256 i = 0; i < count; ++i) {
            string memory prefix = string.concat(".vectors[", vm.toString(i), "]");
            string memory terms = string.concat(prefix, ".terms");

            ReturnDesk.CaseTerms memory t;
            t.caseId = json.readBytes32(string.concat(terms, ".caseId"));
            t.token = json.readAddress(string.concat(terms, ".token"));
            t.totalLoss = vm.parseUint(json.readString(string.concat(terms, ".totalLoss")));
            t.maxReturn = vm.parseUint(json.readString(string.concat(terms, ".maxReturn")));
            t.rewardCap = vm.parseUint(json.readString(string.concat(terms, ".rewardCap")));
            t.refundRoot = json.readBytes32(string.concat(terms, ".refundRoot"));
            t.evidenceHash = json.readBytes32(string.concat(terms, ".evidenceHash"));
            t.nonce = vm.parseUint(json.readString(string.concat(terms, ".nonce")));
            t.chainId = vm.parseUint(json.readString(string.concat(terms, ".chainId")));

            uint256 tierCount = json.readUint(string.concat(terms, ".tierCount"));
            t.tiers = new ReturnDesk.RewardTier[](tierCount);
            for (uint256 j = 0; j < tierCount; ++j) {
                string memory tier = string.concat(terms, ".tiers[", vm.toString(j), "]");
                t.tiers[j] = ReturnDesk.RewardTier(
                    uint64(vm.parseUint(json.readString(string.concat(tier, ".until")))),
                    uint16(json.readUint(string.concat(tier, ".rewardBps")))
                );
            }

            // Deploys the contract at the vector's address and chain, since both are part of the EIP-712 domain.
            address target = json.readAddress(string.concat(prefix, ".verifyingContract"));
            vm.chainId(t.chainId);
            deployCodeTo("ReturnDesk.sol:ReturnDesk", abi.encode(address(0xc0)), target);

            assertEq(ReturnDesk(target).hashCaseTerms(t), json.readBytes32(string.concat(prefix, ".digest")));
        }
    }
}
