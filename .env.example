# Only needed for `make demo-testnet`. `make test`, `make demo-local` and `make verify` need no keys.
# Testnet only. Never put a key that holds real funds here.

# Wallet with Sepolia ETH. It pays for deployments and funds the demo actors.
SEPOLIA_PRIVATE_KEY=
SEPOLIA_DEPLOYER_ADDRESS=
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC=https://base-sepolia-rpc.publicnode.com
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# Optional. Created and appended to .env on the first testnet run if empty.
DEMO_ALICE_KEY=
DEMO_BOB_KEY=
DEMO_CAROL_KEY=
DEMO_ATTACKER_KEY=
DEMO_REWARD_KEY=
